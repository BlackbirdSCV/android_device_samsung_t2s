## vendor prop for t2s

## Fingerprint
ro.vendor.fingerprint.force_calibrate=false
ro.vendor.fingerprint.sensor_location=540|1815|140
ro.vendor.fingerprint.request_touch_event=true
ro.vendor.fingerprint.type=udfps

## RIL
ro.carrier=unknown
ro.radio.noril=no
vendor.rild.libpath=/vendor/lib64/libsec-ril.so
